# Application
APP_ENV=development
DEBUG=true
USE_MOCKS=true
API_KEYS=change-me-in-production

# Telegram — leave empty for API-only / mock demo
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# Database / Redis (defaults match docker-compose)
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/multi_agent_bot
REDIS_URL=redis://localhost:6379/0

# LLM — sensitive → Ollama only; else Ollama → Gemini fallback
LLM_PROVIDER=auto
LLM_MAX_RETRIES=3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_DIMENSIONS=768

# Whisper — local primary, API fallback
WHISPER_MODE=auto
WHISPER_MODEL_SIZE=base
OPENAI_API_KEY=

# Limits
MAX_UPLOAD_BYTES=20971520
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_DIR=./uploads
KNOWLEDGE_DIR=./knowledge
AUTO_INGEST_KNOWLEDGE=true
